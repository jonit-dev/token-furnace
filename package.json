{
  "name": "token-furnace",
  "version": "0.1.0",
  "description": "Where the token budget actually went. Reads local coding-agent transcripts and reports token leaks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "token-furnace": "dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('web/legacy/dashboard.html', 'dist/dashboard.html')\"",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3"
  }
}
