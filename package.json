{
  "name": "token-furnace",
  "version": "0.1.0",
  "description": "Where the token budget actually went. Reads local coding-agent transcripts and reports token leaks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "token-furnace": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vite build --config web/vite.config.ts && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('dist/web/index.html', 'dist/dashboard.html')\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
